-
-                elsif enable ='1' then
-                    if (counter_reg = limit_value) then
-                        counter_reg <= (others => '0');
-                        limit_reached <='1';
-                    else
-                        counter_reg <= std_logic_vector(unsigned (counter_reg)+1);
-                        limit_reached <= '0';
-
-    end if;
-    end if;
-    end if;
-    end process;
-end architecture rtl;
